{
    "name": "denoiser",
    "description": "OIDN denoiser for the web, running fully on WebGPU via onnxruntime-web",
    "keywords": [
        "OIDN",
        "denoise",
        "denoiser",
        "unet",
        "webgpu",
        "onnx",
        "onnxruntime"
    ],
    "version": "2.0.0",
    "author": "Dennis Smolek",
    "contributors": [
        "Dennis Smolek"
    ],
    "license": "MIT",
    "homepage": "https://github.com/pmndrs/denoiser",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pmndrs/denoiser.git",
        "directory": "packages/denoiser"
    },
    "bugs": {
        "url": "https://github.com/pmndrs/denoiser/issues"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./core": {
            "types": "./dist/core.d.ts",
            "import": "./dist/core.mjs",
            "require": "./dist/core.cjs"
        },
        "./ort": {
            "types": "./dist/ort.d.ts",
            "import": "./dist/ort.mjs",
            "require": "./dist/ort.cjs"
        },
        "./kernels": {
            "types": "./dist/kernels.d.ts",
            "import": "./dist/kernels.mjs",
            "require": "./dist/kernels.cjs"
        },
        "./wgsl": {
            "types": "./dist/wgsl.d.ts",
            "import": "./dist/wgsl.mjs",
            "require": "./dist/wgsl.cjs"
        },
        "./webnn": {
            "types": "./dist/webnn.d.ts",
            "import": "./dist/webnn.mjs",
            "require": "./dist/webnn.cjs"
        }
    },
    "typesVersions": {
        "*": {
            "core": [
                "./dist/core.d.ts"
            ],
            "ort": [
                "./dist/ort.d.ts"
            ],
            "kernels": [
                "./dist/kernels.d.ts"
            ],
            "wgsl": [
                "./dist/wgsl.d.ts"
            ],
            "webnn": [
                "./dist/webnn.d.ts"
            ]
        }
    },
    "files": [
        "dist/**",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "vitest run --coverage",
        "build": "rm -rf dist && tsc && rollup --config rollup.config.mjs",
        "format": "prettier --write ."
    },
    "peerDependencies": {
        "@huggingface/kernels": "0.0.1-preview.3"
    },
    "peerDependenciesMeta": {
        "@huggingface/kernels": {
            "optional": true
        }
    },
    "dependencies": {
        "onnxruntime-web": "^1.27.0"
    },
    "devDependencies": {
        "@huggingface/kernels": "0.0.1-preview.3",
        "@pmndrs/denoiser-core": "workspace:*",
        "@pmndrs/denoiser-kernels": "workspace:*",
        "@pmndrs/denoiser-ort": "workspace:*",
        "@pmndrs/denoiser-webnn": "workspace:*",
        "@pmndrs/denoiser-wgsl": "workspace:*",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@typescript-eslint/eslint-plugin": "^8.63.0",
        "@typescript-eslint/parser": "^8.63.0",
        "@webgpu/types": "^0.1.71",
        "eslint": "^10.6.0",
        "prettier": "^3.9.5",
        "rollup": "^4.62.2",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-dts": "^6.5.1",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3"
    }
}
