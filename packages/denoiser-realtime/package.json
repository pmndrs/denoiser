{
    "name": "@pmndrs/denoiser-realtime",
    "description": "Real-time per-signal denoisers for WebGPU in WGSL (diffuse and specular lighting): SVGF / A-SVGF written from the published papers, shared temporal core",
    "keywords": [
        "denoiser",
        "webgpu",
        "wgsl",
        "realtime",
        "svgf",
        "a-svgf",
        "path-tracing",
        "global-illumination"
    ],
    "version": "0.1.0",
    "private": true,
    "author": "Dennis Smolek",
    "license": "MIT",
    "homepage": "https://github.com/pmndrs/denoiser",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pmndrs/denoiser.git",
        "directory": "packages/denoiser-realtime"
    },
    "bugs": {
        "url": "https://github.com/pmndrs/denoiser/issues"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist/**",
        "README.md",
        "LICENSE",
        "NOTICE"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc && rollup --config rollup.config.mjs",
        "dev": "vite --config dev/vite.config.ts --port 5240 --strictPort --host 127.0.0.1"
    },
    "dependencies": {
        "@pmndrs/denoiser-core": "workspace:*"
    },
    "devDependencies": {
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@webgpu/types": "^0.1.71",
        "rollup": "^4.62.2",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vite": "^8.1.4"
    }
}
